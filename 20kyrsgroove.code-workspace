{
  "folders": [
    {
      "path": ".",
      "name": "20,000 Years of Dance Music"
    }
  ],
  "settings": {
    "files.associations": {
      "*.md": "markdown",
      "*.html": "html"
    },
    "files.exclude": {
      "_site": true,
      ".jekyll-cache": true,
      ".sass-cache": true
    },
    "search.exclude": {
      "_site/**": true,
      ".jekyll-cache/**": true
    },
    "[markdown]": {
      "editor.wordWrap": "on",
      "editor.quickSuggestions": {
        "comments": false,
        "strings": false,
        "other": false
      }
    },
    "markdown.preview.breaks": true
  },
  "extensions": {
    "recommendations": [
      "rebornix.ruby",
      "yzhang.markdown-all-in-one",
      "davidanson.vscode-markdownlint",
      "ginfuru.ginfuru-vscode-jekyll-syntax",
      "sissel.shopify-liquid"
    ]
  }
}
